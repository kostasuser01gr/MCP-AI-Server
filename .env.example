# ── Server ──────────────────────────────────────────────
PORT=3030

# ── Auth ────────────────────────────────────────────────
# API key required in x-api-key header (generate your own)
MCP_API_KEY=change-me-to-a-random-string

# Set to "no_auth" to disable auth for local dev
AUTH_MODE=api_key

# JWT secret for web app user sessions
JWT_SECRET=change-me-to-a-long-random-string

# ── Domain Verification (OpenAI) ────────────────────────
# Paste the token from the OpenAI MCP Server form here.
# Alternative: write it to public/.well-known/mcp-verification.txt
# MCP_VERIFICATION_TOKEN=

# ── Database ────────────────────────────────────────────
DB_PATH=./data/app.db

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ── AI Providers (free tiers) ───────────────────────────
# Get keys from each provider's dashboard. You don't need all —
# the AI router auto-selects from whichever keys you provide.

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=

# SambaNova — https://cloud.sambanova.ai/
# SAMBANOVA_API_KEY=

# Together.ai — https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Mistral — https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=

# ── Client ──────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3001
