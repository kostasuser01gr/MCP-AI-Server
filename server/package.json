{
  "name": "mcp-car-rental-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP Car Rental – remote MCP server over HTTP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/db/seed.ts",
    "smoke": "tsx src/smoke.ts",
    "set:verify-token": "node -e \"const fs=require('fs');const p=require('path').resolve(__dirname,'../public/.well-known');fs.mkdirSync(p,{recursive:true});fs.writeFileSync(p+'/mcp-verification.txt',process.argv[1]);console.log('✓ Token written')\" --"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
